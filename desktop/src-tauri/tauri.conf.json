{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glaux",
  "version": "0.1.0",
  "identifier": "ai.glaux.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [
      {
        "title": "Glaux",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
